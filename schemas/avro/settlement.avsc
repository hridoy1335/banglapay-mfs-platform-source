{
  "type": "record",
  "name": "SettlementEvent",
  "namespace": "com.banglapay.events.v1",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_version",
      "type": "int",
      "default": 1
    },
    {
      "name": "occurred_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "source_system",
      "type": "string"
    },
    {
      "name": "aggregate_type",
      "type": "string"
    },
    {
      "name": "aggregate_id",
      "type": "string"
    },
    {
      "name": "correlation_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "run_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "SettlementPayload",
        "fields": [
          {
            "name": "settlement_id",
            "type": "string"
          },
          {
            "name": "settlement_ref",
            "type": "string"
          },
          {
            "name": "merchant_id",
            "type": "string"
          },
          {
            "name": "gross_amount_paisa",
            "type": "long"
          },
          {
            "name": "fee_amount_paisa",
            "type": "long"
          },
          {
            "name": "net_amount_paisa",
            "type": "long"
          },
          {
            "name": "currency",
            "type": "string",
            "default": "BDT"
          },
          {
            "name": "settlement_status",
            "type": "string"
          },
          {
            "name": "period_start",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "period_end",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "settled_at",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null
          },
          {
            "name": "external_bank_reference",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    }
  ]
}
