{
  "type": "record",
  "name": "WalletEvent",
  "namespace": "com.banglapay.events.v1",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_version",
      "type": "int",
      "default": 1
    },
    {
      "name": "occurred_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "source_system",
      "type": "string"
    },
    {
      "name": "aggregate_type",
      "type": "string"
    },
    {
      "name": "aggregate_id",
      "type": "string"
    },
    {
      "name": "correlation_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "run_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "WalletPayload",
        "fields": [
          {
            "name": "wallet_id",
            "type": "string"
          },
          {
            "name": "customer_id",
            "type": "string"
          },
          {
            "name": "change_type",
            "type": "string"
          },
          {
            "name": "source_transaction_id",
            "type": "string"
          },
          {
            "name": "previous_book_balance_paisa",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "book_balance_paisa",
            "type": "long"
          },
          {
            "name": "previous_available_balance_paisa",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "available_balance_paisa",
            "type": "long"
          },
          {
            "name": "held_balance_paisa",
            "type": "long"
          },
          {
            "name": "balance_version",
            "type": "long"
          },
          {
            "name": "currency",
            "type": "string",
            "default": "BDT"
          }
        ]
      }
    }
  ]
}
