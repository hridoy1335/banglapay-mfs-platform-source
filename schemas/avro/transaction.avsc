{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "com.banglapay.events.v1",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "event_version",
      "type": "int",
      "default": 1
    },
    {
      "name": "occurred_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "source_system",
      "type": "string"
    },
    {
      "name": "aggregate_type",
      "type": "string"
    },
    {
      "name": "aggregate_id",
      "type": "string"
    },
    {
      "name": "correlation_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "run_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "TransactionPayload",
        "fields": [
          {
            "name": "transaction_id",
            "type": "string"
          },
          {
            "name": "transaction_ref",
            "type": "string"
          },
          {
            "name": "transaction_type",
            "type": "string"
          },
          {
            "name": "transaction_status",
            "type": "string"
          },
          {
            "name": "amount_paisa",
            "type": "long"
          },
          {
            "name": "currency",
            "type": "string",
            "default": "BDT"
          },
          {
            "name": "sender_wallet_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "receiver_wallet_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "agent_outlet_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "merchant_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "terminal_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "service_provider_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "channel",
            "type": "string"
          },
          {
            "name": "initiated_at",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "completed_at",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "default": null
          },
          {
            "name": "related_transaction_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    }
  ]
}
